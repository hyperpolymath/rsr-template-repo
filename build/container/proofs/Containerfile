#
# Proof-checker toolchains for CI (scripts/check-proofs.sh <prover>).
#
# One Containerfile, one target per prover, so each .github/workflows/proofs.yml
# job builds exactly the toolchain it runs and nothing else. This is NOT the
# application image (build/container/Containerfile, which the template does not
# ship) and `just container-build` does not pick it up: it lives in its own
# directory on purpose.
#
# Every FROM carries @sha256: (scripts/check-container-pins.sh enforces it). The
# idris2 job does not use this file: it runs the digest-pinned
# ghcr.io/stefan-hoeck/idris2-pack image directly (same one pages.yml uses).
#
# Build:  docker|podman build --target <lean4|agda|coq> -f build/container/proofs/Containerfile build/container/proofs
# Run:    <engine> run --rm -v "$PWD:/w" -w /w <image> bash scripts/check-proofs.sh <prover>
#
# The versions below are the ones verification/proofs/<prover>/MANIFEST were
# ground-truthed with where it records one (Lean 4.15.0 = lean-toolchain; Agda
# 2.6.3). The workflow asserts the version the tool actually reports, so a
# floating base can never silently change what "the proofs compile" means.


# ---- lean4: Lean 4.15.0, sha256-checked release tarball (as the devcontainer's Nickel) ----
FROM debian@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS lean4
ARG LEAN_VERSION=4.15.0
ARG LEAN_SHA256=af71a2569a9f68337de2434829b3008cd8e32c436e9cb6bd8c84a2c2ba3585c9
RUN set -eu; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl zstd; \
    curl --proto '=https' --proto-redir '=https' -fsSL \
      "https://github.com/leanprover/lean4/releases/download/v${LEAN_VERSION}/lean-${LEAN_VERSION}-linux.tar.zst" \
      -o /tmp/lean.tar.zst; \
    echo "${LEAN_SHA256}  /tmp/lean.tar.zst" | sha256sum -c -; \
    mkdir -p /opt/lean; \
    zstd -dc /tmp/lean.tar.zst | tar -x -C /opt/lean --strip-components=1; \
    rm -f /tmp/lean.tar.zst; \
    apt-get purge -y curl zstd; apt-get autoremove -y; rm -rf /var/lib/apt/lists/*
ENV PATH=/opt/lean/bin:$PATH
RUN useradd --create-home --uid 1001 prover
USER prover

# ---- agda: Ubuntu 24.04 (noble) ships Agda 2.6.3, the version the MANIFEST was ground-truthed on.
#      (Debian bookworm ships 2.6.2.2 and trixie 2.6.4.3, so neither would do.) ----
FROM ubuntu@sha256:73b999393d07f2bf65a40373778a44dc9a6d54ad7718d29247d8ff9413c4d6a8 AS agda
RUN set -eu; \
    apt-get update; \
    apt-get install -y --no-install-recommends agda-bin; \
    rm -rf /var/lib/apt/lists/*; \
    userdel --remove ubuntu 2>/dev/null || true; \
    useradd --create-home --uid 1001 prover
USER prover

# ---- coq: official coqorg image, Coq 8.20 (coqorg/coq:8.20) ----
FROM coqorg/coq@sha256:3675f124508d7bbfcd509000d5d67e76ed66c1945ccb1f455ce57c6e5d6d52a1 AS coq
# The base image's own non-root user; CI additionally runs with the runner's uid.
USER coq
