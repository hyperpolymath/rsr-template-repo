# SPDX-License-Identifier: MPL-2.0
# SPDX-FileCopyrightText: {{CURRENT_YEAR}} {{AUTHOR}} ({{OWNER}}) <{{AUTHOR_EMAIL}}>
#
# minted by: just repo-init rust-cli ({{CURRENT_YEAR}})
#
# The package name is the repository slug; the CRATE name (what `use` sees) is
# its underscored form, which is the token used in src/*.rs and tests/*.rs.
# `cargo build --all-targets` and `cargo test --all-targets` are what
# `just build` and `just test` run (provision-lib.sh lang_cmd rust:*).

[package]
name = "{{REPO}}"
version = "0.1.0"
edition = "2021"
rust-version = "1.80"
license = "MPL-2.0"
description = "{{PROJECT_DESCRIPTION}}"
authors = ["{{AUTHOR}} <{{AUTHOR_EMAIL}}>"]
repository = "https://{{FORGE}}/{{OWNER}}/{{REPO}}"
readme = "README.adoc"

[dependencies]

# Keep the release profile explicit: a CLI is shipped as a binary, and the
# defaults differ between toolchains more than they look.
[profile.release]
codegen-units = 1
lto = true
panic = "abort"
strip = true
