; WIP modules excluded from the build (2026-04-19):
;   - backends, backends/*: M5 sweep shipped a wrapper that references
;     16 Backends_* modules, of which only 5 sub-files exist and none
;     under the expected flat naming convention.  Nothing else in the
;     tree consumes the Backends namespace, so exclude until whoever
;     owns the backend-layer refactor rewires backends.ml.
;   - face, {javascript,python,pseudocode}_face: the face-transformer
;     stubs reference token / AST constructors (Ident, EIdent, EBinOp,
;     EUnOp) that don't exist in the current Token.t / Ast.expr.
;     Nothing outside face.mli consumes them either.  Exclude until
;     the face stack is rebuilt against the current Token/Ast shape.
(library
 (name affinescript)
 (libraries core sedlex menhirLib yojson unix str)
 (modules :standard \ backends face javascript_face python_face pseudocode_face)
 (preprocess (pps ppx_jane ppx_deriving.show ppx_deriving.eq ppx_deriving.ord sedlex.ppx))
 (flags :standard -w -A))

; parser.mly -> module Parser generated by menhir, consumed by
; parse_driver.ml and parse.ml (via MenhirInterpreter).
(menhir
 (modules parser)
 (flags --table))
