; WIP modules excluded from the build (2026-04-19):
;   - face, {javascript,python,pseudocode}_face: the face-transformer
;     stubs reference token / AST constructors (Ident, EIdent, EBinOp,
;     EUnOp) that don't exist in the current Token.t / Ast.expr.
;     Nothing outside face.mli consumes them either.  Exclude until
;     the face stack is rebuilt against the current Token/Ast shape.
;
; `backends.ml` and `lib/backends/` were deleted — the M5-sweep
; scaffolding referenced 9+ modules that were never written.  Git
; history preserves the content for anyone picking up the backend-
; layer refactor.
(library
 (name affinescript)
 (libraries sedlex menhirLib yojson unix str)
 (modules :standard \ face javascript_face python_face pseudocode_face)
 ; ppx_jane dropped: code only uses [@@deriving show, eq, ord], all
 ; provided by ppx_deriving plugins.  ppx_jane transitively pulled in
 ; ppx_bin_prot / bin_prot whose runtime.js fires `joo_global_object`
 ; deprecation warnings under js_of_ocaml 6.2.  Narrower preprocess
 ; list removes that closure.
 (preprocess (pps ppx_deriving.show ppx_deriving.eq ppx_deriving.ord sedlex.ppx))
 (flags :standard -w -A))

; parser.mly -> module Parser generated by menhir, consumed by
; parse_driver.ml and parse.ml (via MenhirInterpreter).
(menhir
 (modules parser)
 (flags --table))
